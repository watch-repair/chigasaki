---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ContentPage from '../../components/ContentPage.astro';

export async function getStaticPaths() {
  const parts = await getCollection('parts');
  return parts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<'parts'>;
};

const { entry } = Astro.props;
---

<ContentPage entry={entry} collection="parts" bodyClass="about__content">
  <span slot="heading">
    {entry.data.title}
    <span class="jp-text" lang="ja">
      {entry.data.category === 'part' ? 'パーツ' : entry.data.category}
    </span>
  </span>
</ContentPage>
