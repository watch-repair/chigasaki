---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ContentPage from '../../components/ContentPage.astro';

export async function getStaticPaths() {
  const movements = await getCollection('movements');
  return movements.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = {
  entry: CollectionEntry<'movements'>;
};

const { entry } = Astro.props;
---

<ContentPage entry={entry} collection="movements" bodyClass="about__content">
  <span slot="heading">{entry.data.title}</span>

  <div slot="meta" class="movement-meta">
    <span class="movement-meta__badge">
      <span aria-hidden="true">📍</span>
      {entry.data.country}
    </span>
    <span class="movement-meta__badge">
      <span aria-hidden="true">📅</span>
      Founded {entry.data.founded}
    </span>
  </div>

  <p slot="lead" class="movement-lead">{entry.data.description}</p>
</ContentPage>
