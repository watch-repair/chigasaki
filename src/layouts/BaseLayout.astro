---
export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  structuredData?: object[];
}

const {
  title = "Kawabata's Vintage Quartz Watch Repair | Chigasaki, Japan",
  description = "茅ヶ崎の川端時計修理は、ヴィンテージクォーツ時計の専門修理工房。セイコー、シチズン、カシオなど日本製時計の電池交換、ムーブメント洗浄、リューズ修理に対応。山田電機LABI LIFE SELECT茅ヶ崎店内。",
  keywords = "茅ヶ崎,時計修理,クォーツ時計,ヴィンテージ時計,電池交換,セイコー,シチズン,カシオ,オリエント,山田電機,vintage watch repair,quartz watch repair,Chigasaki",
  canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined,
  ogImage = `${(Astro.site?.toString().replace(/\/$/, '') ?? 'https://chigasaki.repairwatch.workers.dev')}/images/hero.png`,
  ogType = "website",
  noindex = false,
  structuredData = [],
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://chigasaki.repairwatch.workers.dev';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="keywords" content={keywords}>
  <meta name="author" content="Kawabata's Vintage Quartz Watch Repair">
  <meta name="theme-color" content="#1a1a2e">
  {noindex ? <meta name="robots" content="noindex, nofollow"> : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">}
  {canonical && <link rel="canonical" href={canonical} />}

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-EFRNLR25JE"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-EFRNLR25JE');
  </script>

  <title>{title}</title>

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical ?? siteUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="ja_JP" />
  <meta property="og:locale:alternate" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Styles -->
  <link rel="stylesheet" href="/css/reset.css">
  <link rel="stylesheet" href="/css/variables.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">

  <!-- Favicon placeholder -->
  <!-- <link rel="icon" type="image/svg+xml" href="/images/favicon.svg"> -->

  {structuredData.map((data) => (
    <script type="application/ld+json" set:html={JSON.stringify(data)} />
  ))}
</head>
<body>
  <slot />
  <script src="/js/menu.js" is:inline></script>
  <script is:inline>
    document.getElementById('year').textContent = new Date().getFullYear();
  </script>
</body>
</html>
