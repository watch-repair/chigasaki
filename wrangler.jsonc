{
	"compatibility_date": "2026-05-01",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "chigasaki",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"pages_build_output_dir": "dist/client",
	"assets": {
		"directory": "./dist",
		"binding": "STATIC_ASSETS"
	},
	"observability": {
		"enabled": true
	}
}